[Unit]
Description=MediaMTX RTSP/WebRTC Server
After=network.target local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
RequiresMountsFor=__BASE_DIR__
ConditionPathIsDirectory=__BASE_DIR__/mediamtx
ConditionPathExists=__BASE_DIR__/mediamtx/mediamtx

[Service]
Type=simple
WorkingDirectory=__BASE_DIR__/mediamtx
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do ls /dev/video* >/dev/null 2>&1 && exit 0; sleep 1; done; echo "No /dev/video* found after 30s, continuing anyway." >&2; exit 0'
ExecStartPre=/bin/sleep 5
ExecStart=__BASE_DIR__/mediamtx/mediamtx
Restart=always
RestartSec=5
User=__USERNAME__
# Access to /dev/video* and /dev/dri (filled with the groups that exist on this system)
SupplementaryGroups=__SUPPLEMENTARY_GROUPS__

[Install]
WantedBy=multi-user.target
