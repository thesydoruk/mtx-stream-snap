[Unit]
Description=SnapFeeder Flask Snapshot Server
After=network.target local-fs.target mediamtx.service
Requires=mediamtx.service
PartOf=mediamtx.service
RequiresMountsFor=__BASE_DIR__
ConditionPathIsDirectory=__BASE_DIR__/scripts
ConditionPathExists=__VENV_DIR__/bin/python

[Service]
Type=simple
WorkingDirectory=__BASE_DIR__/scripts
ExecStartPre=/bin/bash -c 'for i in $(seq 1 45); do (echo >/dev/tcp/127.0.0.1/8554) >/dev/null 2>&1 && exit 0; sleep 1; done; echo "mediamtx RTSP not ready after 45s, continuing anyway." >&2; exit 0'
ExecStart=__VENV_DIR__/bin/python __BASE_DIR__/scripts/snapfeeder.py
Restart=on-failure
RestartSec=3
User=__USERNAME__

[Install]
WantedBy=multi-user.target